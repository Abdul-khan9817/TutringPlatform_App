# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (use connection pooler URL for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/workspeak?schema=public"
# Direct URL for migrations (bypasses connection pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/workspeak?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
# Token lifetimes in seconds
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret from: stripe listen --forward-to localhost:3000/api/v1/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=WorkSpeak Portugal <hello@workspeakportugal.com>
EMAIL_ADMIN=admin@workspeakportugal.com

# ─── File Storage (Cloudflare R2 or S3-compatible) ────────────────────────────
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_BUCKET=workspeak-files
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_PUBLIC_URL=https://files.workspeakportugal.com

# ─── Redis (rate limiting, distributed) ───────────────────────────────────────
# Optional in dev; required in production with multiple instances
REDIS_URL=redis://localhost:6379

# ─── Business ─────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Europe/Lisbon
DEFAULT_CURRENCY=EUR
WHATSAPP_PHONE_NUMBER=+351916869857
NEXT_PUBLIC_WHATSAPP=+351916869857

# ─── Admin provisioning ───────────────────────────────────────────────────────
# Used ONLY by: npm run admin:create
# Remove from environment after first admin is created
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
